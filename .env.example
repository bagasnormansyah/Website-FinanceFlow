# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used by /api/cron/recurring. Send it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Keep this stable across deployments/instances. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional, used for absolute links in emails/redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
